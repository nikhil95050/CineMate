# --- Core bot configuration ---

# Telegram
TELEGRAM_BOT_TOKEN=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Redis
REDIS_URL=

# Perplexity (LLM for discovery and semantic intent classification)
PERPLEXITY_API_KEY=

# TMDB -- primary movie data provider
TMDB_API_KEY=

# OMDb -- fallback movie data provider
OMDB_API_KEY=

# WatchMode -- streaming availability
WATCHMODE_API_KEY=

# Optional Feature Flags (default: true)
ENABLE_PERPLEXITY=false
ENABLE_TRAILERS=true
ENABLE_EXPLANATIONS=true

# Admin
ADMIN_CHAT_IDS=
ADMIN_PASSWORD=

# Name of the Redis queue for background jobs.
CINEMATE_QUEUE_NAME=cinemate_intent_jobs

# For local dev / tests: run jobs inline instead of via RQ worker.
CINEMATE_INLINE_JOBS=1

# Deployment environment (development / production)
CINEMATE_ENV=development

# Render external URL for keepalive (set automatically on Render)
RENDER_EXTERNAL_URL=
